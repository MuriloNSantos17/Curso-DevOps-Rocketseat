# Dependencies and generated files (at any directory depth)
node_modules/
dist/
build/
coverage/
.nyc_output/
*.tsbuildinfo
.cache/
.npm/
.pnpm-store/

# Keep package manifests, lockfiles, source, tests and Kubernetes YAMLs
# versioned. Ignore only local environment values, keeping examples.
.env
.env.*
!.env.example
!.env.sample
!.env.template

# Terraform local data and credentials; keep .terraform.lock.hcl
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
*.tfplan
crash.log
crash.*.log
rocketseat-467022-8452d52d80e0.json

# Logs and runtime data
logs/
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
pids/
*.pid
*.seed
*.pid.lock
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Local editors and operating-system files
.vscode/
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo

